# Copia este archivo a .env y completa los valores. NO subas .env al repositorio.

# URL base de Evolution API (sin barra final), escrita desde la perspectiva del host,
# p. ej. http://localhost:8080. Dentro de Docker el servidor traduce solo localhost y
# 127.0.0.1 a host.docker.internal; no hace falta cambiarla.
EVOLUTION_BASE_URL=http://localhost:8080

# API key de Evolution (requerida). Se envia en el header "apikey".
EVOLUTION_API_KEY=<tu-api-key-de-evolution>

# Nombre de la instancia de Evolution conectada a WhatsApp (requerida).
EVOLUTION_INSTANCE=<nombre-de-la-instancia>

# Tu numero (alias "me"): solo digitos con codigo de pais, o un JID (...@s.whatsapp.net).
WHATSAPP_ME=<tu-numero-con-codigo-de-pais>

# Tu equipo (alias "team"): lista separada por comas de numeros o JIDs de grupo (...@g.us).
WHATSAPP_TEAM=<numero1,numero2,id-de-grupo@g.us>

# Tiempo limite por llamada a Evolution, en milisegundos.
EVOLUTION_TIMEOUT_MS=30000

# Transporte del servidor MCP: stdio (por defecto) o http.
MCP_TRANSPORT=stdio

# Puerto del servidor MCP cuando MCP_TRANSPORT=http (tambien lo usa docker compose para publicarlo).
MCP_PORT=8787

# Interfaz donde escucha el servidor MCP cuando MCP_TRANSPORT=http.
# Por defecto 127.0.0.1 (solo local). En Docker el compose fija MCP_HOST=0.0.0.0.
MCP_HOST=127.0.0.1

# Contrasena de la base de datos de Evolution. La usa solo docker-compose.evolution.yml.
# Escribe una larga con SOLO letras y numeros (sin simbolos ni espacios). Ver README.
EVOLUTION_DB_PASSWORD=<contrasena-larga-solo-letras-y-numeros>
